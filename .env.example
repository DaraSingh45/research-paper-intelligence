POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=research_papers
POSTGRES_USER=research_user
POSTGRES_PASSWORD=change_me_please


OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

CONTACT_EMAIL=you@example.com

# --- OpenAlex API key (recommended) ---
# As of Feb 2026, OpenAlex requires a free API key for reliable access.
# Get one in under a minute at https://openalex.org/settings/api
# Leave blank to use OpenAlex's small unauthenticated test quota.
OPENALEX_API_KEY= YOUR_API_KEY

# --- Semantic Scholar API key (optional but recommended) ---
# Not strictly required, but the unauthenticated pool is shared globally
# and often rate-limited. A free key gives you a dedicated rate instead:
# https://www.semanticscholar.org/product/api#Get-Started
SEMANTIC_SCHOLAR_API_KEY=

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data

# --- Airflow (only used if you run the optional Airflow profile) ---
AIRFLOW_UID=50000
